{
	"name": "obsidian-ocr-preview",
	"version": "0.1.0",
	"description": "Review view for OCR preview files of obsidian-ocr-pipeline",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"check": "tsc --noEmit",
		"lint": "eslint .",
		"test": "node --test --experimental-strip-types test/*.test.ts"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "1.12.3",
		"typescript": "^5.8.3"
	}
}

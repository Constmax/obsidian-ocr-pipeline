{
  "comment": "Seam between the CLIs (Stage 1 bin/, Stage 2 pdf2md) and the Obsidian plugin (Issue #55). Both test suites read this file; docs/cli-contract.md explains it.",
  "progress": {
    "protocol": 1,
    "fixture": "progress-v1.jsonl",
    "events": {
      "start": {
        "required": {"typ": "string", "protokoll": "integer", "datei": "string", "seiten": "integer", "dpi": "integer"},
        "optional": {}
      },
      "seite": {
        "required": {"typ": "string", "protokoll": "integer", "nr": "integer", "von": "integer", "sekunden": "number", "herkunft": "string", "entgleist": "boolean"},
        "optional": {"grund": "string"}
      },
      "fertig": {
        "required": {"typ": "string", "protokoll": "integer", "ziel": "string", "sekunden": "number", "entgleist": "integer"},
        "optional": {}
      }
    },
    "origins": ["textlayer", "ocr", "diagramm"]
  },
  "exitCodes": {
    "success": 0,
    "error": 1,
    "usage": 2,
    "check-failed": 4,
    "cancelled-partial": 6,
    "cancelled-empty": 7
  },
  "check": {
    "comment": "Issue #28: the settings tab runs pdf2md --check --fortschritt --out <preview folder> and lists every check. One JSON document on stdout; exit success or check-failed.",
    "args": ["--check", "--fortschritt"],
    "document": {"typ": "string", "ok": "boolean", "checks": "array", "warnungen": "array"},
    "check": {"name": "string", "ok": "boolean", "detail": "string"},
    "names": ["python", "fitz", "mlx_vlm", "modell", "ausgabe", "speicher"],
    "example": {"typ": "check", "ok": false, "checks": [{"name": "python", "ok": true, "detail": "3.12.4"}, {"name": "mlx_vlm", "ok": false, "detail": "nicht installiert"}], "warnungen": ["speicher: 7.5 GiB (weniger als 8 GiB — Parallelbetrieb riskiert OOM)"]}
  },
  "stage2Defaults": {"dpi": 150, "tileFrom": 3000},
  "inputSuffixes": [".bmp", ".jpeg", ".jpg", ".pdf", ".png", ".tif", ".tiff"],
  "previewFormat": 1,
  "stage1": {
    "shortPages": {
      "command": "column_tools.py verify-pages",
      "minChars": 50,
      "pages": ["Erste Seite mit genug Text, um den B5-Mindestwert zu erreichen.", "short", "Erste Seite mit genug Text, um den B5-Mindestwert zu erreichen.", ""],
      "stderr": [
        "   🗑️  Page 2: only 5 characters (min: 50)",
        "   🗑️  Page 4: only 0 characters (min: 50)"
      ],
      "shortPageNumbers": [2, 4]
    },
    "failure": {
      "command": "reprocess-raw.sh missing.pdf",
      "stdout": ["❌ File not found: missing.pdf"],
      "reason": "File not found: missing.pdf"
    },
    "checkEngine": {
      "comment": "Issue #73: the plugin offers PaddleOCR only when this check exits 0 (success); check-failed carries the reason on stderr.",
      "args": ["--check-engine", "--engine", "paddle", "--paddle-mode", "fast"],
      "notUsable": {
        "exitCode": "check-failed",
        "stderr": [
          "❌ PaddleOCR engine plugin not installed (ocrmypdf_paddle).",
          "   Put its venv first on PATH, or PYTHONPATH=<repo>/ocrmypdf_paddle/src: docs/installation.md"
        ],
        "reason": "PaddleOCR engine plugin not installed (ocrmypdf_paddle). Put its venv first on PATH, or PYTHONPATH=<repo>/ocrmypdf_paddle/src: docs/installation.md"
      }
    }
  }
}

#!/usr/bin/env bash
# Wrapper für Stufe 2: führt pdf2md.py mit dem MLX-venv aus.
# Wird von setup.sh nach ~/bin verlinkt; funktioniert von überall.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    TARGET="$(readlink "$SELF")"
    case "$TARGET" in
        /*) SELF="$TARGET" ;;
        *) SELF="$(dirname "$SELF")/$TARGET" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"

# ./setup.sh (Repo-Wurzel) legt das venv unter ~/.venvs/mlxocr an — das ist
# der Normalfall. pdf2md/setup.sh legt es stattdessen unter
# $VAULT_ROOT/.venv-mlxocr an (bzw. relativ zum cwd, meist der Vault-Root, von
# wo aus konvertiert wird); beide Wege bleiben unterstützt.
VENV_PY=""
for kandidat in \
    "$HOME/.venvs/mlxocr/bin/python" \
    "${VAULT_ROOT:-}/.venv-mlxocr/bin/python" \
    "$PWD/.venv-mlxocr/bin/python"
do
    # Neben dem Pfad auch pruefen, dass pymupdf im venv liegt: ein venv ohne
    # `import fitz` laesst den Lauf erst nach dem Modell-Download scheitern.
    if [ -n "$kandidat" ] && [ -x "$kandidat" ] \
        && "$kandidat" -c "import fitz" >/dev/null 2>&1; then
        VENV_PY="$kandidat"
        break
    fi
done

if [ -z "$VENV_PY" ]; then
    echo "❌ MLX-venv nicht gefunden (weder ~/.venvs/mlxocr noch \$VAULT_ROOT/.venv-mlxocr). Einmal ./setup.sh im Repo ausführen." >&2
    exit 1
fi

exec "$VENV_PY" "$SCRIPT_DIR/../pdf2md/pdf2md.py" "$@"

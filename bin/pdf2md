#!/usr/bin/env bash
# Wrapper for Stage 2: executes pdf2md.py with the MLX venv.
# Symlinked to ~/bin by setup.sh; works from anywhere.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    TARGET="$(readlink "$SELF")"
    case "$TARGET" in
        /*) SELF="$TARGET" ;;
        *) SELF="$(dirname "$SELF")/$TARGET" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"

VENV_PY="${VENV_ROOT:-$HOME/.venvs}/mlxocr/bin/python"
if [ ! -x "$VENV_PY" ]; then
    echo "❌ MLX venv missing ($VENV_PY). Run ./setup.sh in repo once." >&2
    exit 1
fi
# A venv without pymupdf would only let pdf2md.py fail at `import fitz`
# (after downloading model) — catch here with a clear error message.
if ! "$VENV_PY" -c "import fitz" >/dev/null 2>&1; then
    echo "❌ pymupdf missing in $VENV_PY — re-run ./setup.sh in repo." >&2
    exit 1
fi

exec "$VENV_PY" "$SCRIPT_DIR/../pdf2md/pdf2md.py" "$@"

